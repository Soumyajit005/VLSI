digraph "full_adder" {
label="full_adder";
rankdir="LR";
remincross=true;
n6 [ shape=octagon, label="Cout", color="black", fontcolor="black"];
n7 [ shape=octagon, label="Sum", color="black", fontcolor="black"];
n8 [ shape=octagon, label="Cin", color="black", fontcolor="black"];
n9 [ shape=octagon, label="B", color="black", fontcolor="black"];
n10 [ shape=octagon, label="A", color="black", fontcolor="black"];
c12 [ shape=record, label="{{<p10> A|<p9> B}|$87\n$_OR_|{<p11> Y}}",  ];
c13 [ shape=record, label="{{<p10> A|<p9> B}|$88\n$_NAND_|{<p11> Y}}",  ];
c14 [ shape=record, label="{{<p10> A|<p9> B}|$89\n$_NAND_|{<p11> Y}}",  ];
c15 [ shape=record, label="{{<p10> A|<p9> B}|$90\n$_NAND_|{<p11> Y}}",  ];
c16 [ shape=record, label="{{<p10> A|<p9> B}|$91\n$_OR_|{<p11> Y}}",  ];
c18 [ shape=record, label="{{<p10> A|<p9> B|<p17> S}|$92\n$_MUX_|{<p11> Y}}",  ];
c19 [ shape=record, label="{{<p10> A|<p9> B}|$93\n$_AND_|{<p11> Y}}",  ];
n1 [ shape=point ];
c12:p11:e -> n1:w [color="black", fontcolor="black", label=""];
n1:e -> c14:p9:w [color="black", fontcolor="black", label=""];
n1:e -> c16:p9:w [color="black", fontcolor="black", label=""];
n10:e -> c12:p9:w [color="black", fontcolor="black", label=""];
n10:e -> c13:p9:w [color="black", fontcolor="black", label=""];
n2 [ shape=point ];
c13:p11:e -> n2:w [color="black", fontcolor="black", label=""];
n2:e -> c15:p10:w [color="black", fontcolor="black", label=""];
n2:e -> c18:p17:w [color="black", fontcolor="black", label=""];
n3 [ shape=point ];
c14:p11:e -> n3:w [color="black", fontcolor="black", label=""];
n3:e -> c15:p9:w [color="black", fontcolor="black", label=""];
n3:e -> c18:p9:w [color="black", fontcolor="black", label=""];
c16:p11:e -> c19:p10:w [color="black", fontcolor="black", label=""];
c18:p11:e -> c19:p9:w [color="black", fontcolor="black", label=""];
c15:p11:e -> n6:w [color="black", fontcolor="black", label=""];
c19:p11:e -> n7:w [color="black", fontcolor="black", label=""];
n8:e -> c12:p10:w [color="black", fontcolor="black", label=""];
n8:e -> c13:p10:w [color="black", fontcolor="black", label=""];
n9:e -> c14:p10:w [color="black", fontcolor="black", label=""];
n9:e -> c16:p10:w [color="black", fontcolor="black", label=""];
n9:e -> c18:p10:w [color="black", fontcolor="black", label=""];
}
